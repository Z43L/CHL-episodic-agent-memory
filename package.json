{
  "name": "chl-extension",
  "version": "0.2.0",
  "private": true,
  "type": "commonjs",
  "bin": {
    "chl-mcp": "./bin/chl-mcp.js"
  },
  "scripts": {
    "build:native": "node scripts/build-native.js",
    "build:hyperembed": "node scripts/build-hyperembed.js",
    "build": "npm run build:native && npm run build:hyperembed",
    "test": "npm run build:native && node --test",
    "eval": "node scripts/evaluate.js",
    "serve": "node src/server.js",
    "serve:mcp": "node src/mcp-server.js",
    "bootstrap:chl:memory": "node scripts/bootstrap-chl-memory-from-jsonl.js",
    "ingest:dir:chl": "node scripts/ingest-directory-into-chl.js",
    "chat:tui": "node scripts/chat-tui.js",
    "bridge:openai": "node -e \"const {createBridge}=require('./src/bridge/bridge');const b=createBridge({provider:'openai',persistPath:process.env.CHL_PERSIST_PATH});b.turn(process.argv[2]||'hola').then(r=>{console.log(r.response);b.close()})\"",
    "bridge:anthropic": "node -e \"const {createBridge}=require('./src/bridge/bridge');const b=createBridge({provider:'anthropic',persistPath:process.env.CHL_PERSIST_PATH});b.turn(process.argv[2]||'hola').then(r=>{console.log(r.response);b.close()})\"",
    "bridge:ollama": "node -e \"const {createBridge}=require('./src/bridge/bridge');const b=createBridge({provider:'ollama',persistPath:process.env.CHL_PERSIST_PATH});b.turn(process.argv[2]||'hola').then(r=>{console.log(r.response);b.close()})\""
  }
}
